# Auto-generated by @taucad/wasm-build — do not edit manually
# OCCT: 48ebca0f70a5  (V8_0_0_rc4 (master tip))
# Emscripten: 5.0.1

FROM emscripten/emsdk:5.0.1@sha256:c89732ef63a56de5a96395c5a8c1c7904f7420131a045406e6fedc4cbe1cc198 AS base-image

RUN \
  apt-get update -y && \
  apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    cmake \
    curl \
    doxygen \
    git \
    python3 \
    python3-pip \
    python3-setuptools && \
  rm -rf /var/lib/apt/lists/*

# Python dependencies for binding generation
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --break-system-packages -r /tmp/requirements.txt 2>/dev/null || \
    pip3 install -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Clone dependencies at pinned commits
WORKDIR /rapidjson/
RUN git clone https://github.com/Tencent/rapidjson.git . && git checkout 24b5e7a8b27f42fa16b96fc70aade9106cf7102f

WORKDIR /freetype/
RUN git clone https://github.com/freetype/freetype.git . && git checkout de8b92dd7ec634e9e2b25ef534c54a3537555c11

WORKDIR /occt/
RUN git clone https://github.com/Open-Cascade-SAS/OCCT.git . && git checkout 48ebca0f70a5e4b936548b695bc3583363898da4

# Generate Standard_Version.hxx (normally produced by CMake configure_file)
RUN printf "#ifndef _Standard_Version_HeaderFile\n#define _Standard_Version_HeaderFile\n#define OCC_VERSION_MAJOR 8\n#define OCC_VERSION_MINOR 0\n#define OCC_VERSION_MAINTENANCE 0\n#define OCC_VERSION_DEVELOPMENT \"rc4\"\n#define OCC_VERSION 8.0\n#define OCC_VERSION_STRING \"8.0\"\n#define OCC_VERSION_COMPLETE \"8.0.0\"\n#define OCC_VERSION_STRING_EXT \"8.0.0.rc4\"\n#define OCC_VERSION_HEX 0x080000\n#endif\n" > src/FoundationClasses/TKernel/Standard/Standard_Version.hxx

# Copy the build system
WORKDIR /opencascade.js/
COPY src ./src
COPY build-configs ./build-configs
COPY build-wasm.sh ./build-wasm.sh
COPY bindgen-filters.yaml ./bindgen-filters.yaml
COPY DEPS.json ./DEPS.json
RUN chmod +x build-wasm.sh

# Default environment
ENV OCCT_ROOT=/occt
ENV RAPIDJSON_ROOT=/rapidjson
ENV FREETYPE_ROOT=/freetype
ENV THREADING=single-threaded
ENV OCJS_OPT=-O2
ENV OCJS_LTO=0
ENV OCJS_EXCEPTIONS=0

RUN mkdir -p build/bindings build/sources build/dist /output

# Apply OCCT source patches
RUN python3 src/applyPatches.py

ENTRYPOINT ["/opencascade.js/build-wasm.sh"]
CMD ["full", "build-configs/full.yml"]
