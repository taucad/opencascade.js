llection_List_TopoDS_Shape","comment":"Returns the faces which are the left of the projected wires and which are."},{"name":"Left","signature":"(): NCollection_List_TopoDS_Shape","parameters":[],"returnType":"NCollection_List_TopoDS_Shape","comment":"Returns the faces of the \"left\" part on the shape. (It is build from DirectLeft, with the faces connected to this set, and so on...)."},{"name":"DescendantShapes","signature":"(S: TopoDS_Shape): NCollection_List_TopoDS_Shape","parameters":[{"name":"S","type":"TopoDS_Shape","optional":false,"rest":false}],"returnType":"NCollection_List_TopoDS_Shape","comment":"Returns the list of descendant shapes of ."}],"properties":[]},{"name":"LocOpe_SplitShape","kind":"class","summary":"Provides a tool to cut:\n- edges with a vertices,\n- faces with wires, and rebuilds the shape containing the edges and the faces.","extends":[],"ancestors":[],"constructors":[{"name":"constructor","signature":"()","parameters":[],"returnType":"LocOpe_SplitShape","comment":"Empty constructor."},{"name":"constructor","signature":"(S: TopoDS_Shape)","parameters":[{"name":"S","type":"TopoDS_Shape","optional":false,"rest":false}],"returnType":"LocOpe_SplitShape","comment":"Creates the process with the shape ."}],"staticMethods":[],"instanceMethods":[{"name":"Init","signature":"(S: TopoDS_Shape): void","parameters":[{"name":"S","type":"TopoDS_Shape","optional":false,"rest":false}],"returnType":"void","comment":"Initializes the process on the shape ."},{"name":"CanSplit","signature":"(E: TopoDS_Edge): boolean","parameters":[{"name":"E","type":"TopoDS_Edge","optional":false,"rest":false}],"returnType":"boolean","comment":"Tests if it is possible to split the edge <E>."},{"name":"Add","signature":"(W: TopoDS_Wire, F: TopoDS_Face): boolean","parameters":[{"name":"W","type":"TopoDS_Wire","optional":false,"rest":false},{"name":"F","type":"TopoDS_Face","optional":false,"rest":false}],"returnType":"boolean","comment":"Adds the wire <W> on the face <F>."},{"name"