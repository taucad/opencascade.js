{
  "name": "ocjs",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "root": ".",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./scripts/setup-deps.sh",
        "cwd": "{projectRoot}"
      }
    },
    "apply-patches": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["setup"],
      "inputs": [
        "patchScripts",
        "buildScript",
        "depsVersion",
        { "runtime": "git -C deps/OCCT rev-parse HEAD 2>/dev/null || echo missing" },
        { "env": "OCJS_PATCH_DUMP" },
        { "env": "OCJS_PATCH_STEPCAF" }
      ],
      "outputs": ["{projectRoot}/build/patches-applied"],
      "options": {
        "command": "./build-wasm.sh apply-patches",
        "cwd": "{projectRoot}"
      }
    },
    "pch": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["apply-patches"],
      "inputs": [
        "compileConfig",
        "toolchain",
        "buildScript",
        "patchScripts",
        "depsVersion",
        { "runtime": "git -C deps/OCCT rev-parse HEAD 2>/dev/null || echo missing" },
        { "runtime": "git -C deps/OCCT diff HEAD --stat 2>/dev/null | shasum -a 256 || echo clean" },
        { "dependentTasksOutputFiles": "**/patches-applied", "transitive": false }
      ],
      "outputs": [
        "{projectRoot}/build/pch.h.pch",
        "{projectRoot}/build/pch.h",
        "{projectRoot}/build/occt-includes/",
        "{projectRoot}/build/build-flags.json"
      ],
      "options": {
        "command": "./build-wasm.sh pch",
        "cwd": "{projectRoot}"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["setup", "pch"],
      "inputs": [
        "generatorCode",
        "buildScript",
        "depsVersion",
        { "runtime": "git -C deps/OCCT rev-parse HEAD 2>/dev/null || echo missing" }
      ],
      "outputs": ["{projectRoot}/build/bindings/", "{projectRoot}/build/ncollection-manifest.json"],
      "options": {
        "command": "./build-wasm.sh generate",
        "cwd": "{projectRoot}"
      }
    },
    "compile-bindings": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["pch", "generate"],
      "inputs": [
        "compileConfig",
        "toolchain",
        "buildScript",
        "compileBindingsScript",
        { "dependentTasksOutputFiles": "**/*.cpp", "transitive": false }
      ],
      "outputs": ["{projectRoot}/build/compiled-bindings/"],
      "options": {
        "command": "./build-wasm.sh bindings",
        "cwd": "{projectRoot}"
      }
    },
    "compile-sources": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["pch", "apply-patches"],
      "inputs": [
        "compileConfig",
        "toolchain",
        "buildScript",
        "patchScripts",
        "depsVersion",
        { "runtime": "git -C deps/OCCT rev-parse HEAD 2>/dev/null || echo missing" },
        { "runtime": "git -C deps/OCCT diff HEAD --stat 2>/dev/null | shasum -a 256 || echo clean" }
      ],
      "outputs": ["{projectRoot}/build/occt-cmake/", "{projectRoot}/build/.cmake-lib-dir"],
      "options": {
        "command": "./build-wasm.sh sources",
        "cwd": "{projectRoot}"
      }
    },
    "dts": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["generate"],
      "options": {
        "command": "./build-wasm.sh dts \"${OCJS_YAML}\"",
        "cwd": "{projectRoot}"
      }
    },
    "link": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["compile-bindings", "compile-sources", "generate"],
      "inputs": [
        "compileConfig",
        "linkConfig",
        "toolchain",
        "buildScript",
        "linkScript",
        { "env": "OCJS_YAML" },
        { "runtime": "shasum -a 256 \"${OCJS_YAML:-/dev/null}\" 2>/dev/null || echo no-yaml" },
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": ["{projectRoot}/dist/"],
      "options": {
        "command": "./build-wasm.sh link \"${OCJS_YAML}\"",
        "cwd": "{projectRoot}",
        "env": {
          "OCJS_OUTPUT_DIR": "{projectRoot}/dist",
          "OCJS_CONFIG": "O3-wasm-exc-simd"
        }
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["link"],
      "options": {
        "command": ".venv/bin/python scripts/validate-build.py \"${OCJS_YAML}\" dist/ --build-dir build",
        "cwd": "{projectRoot}"
      }
    },
    "provenance": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["link"],
      "options": {
        "command": "./build-wasm.sh provenance \"${OCJS_YAML}\"",
        "cwd": "{projectRoot}",
        "env": {
          "OCJS_OUTPUT_DIR": "{projectRoot}/dist",
          "OCJS_CONFIG": "O3-wasm-exc-simd"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["validate", "provenance"],
      "options": {
        "command": "echo 'Build complete. Outputs in dist/'"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["link"],
      "inputs": [
        "{projectRoot}/scripts/generate-docs.mjs",
        "{projectRoot}/scripts/lib/dts-parser.mjs",
        "{projectRoot}/dist/opencascade_full.d.ts",
        "{projectRoot}/dist/opencascade_full.build-manifest.json",
        { "dependentTasksOutputFiles": "**/*.d.ts.json", "transitive": false }
      ],
      "outputs": ["{projectRoot}/docs-site/data/"],
      "options": {
        "command": "node scripts/generate-docs.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "docs-serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["docs"],
      "options": {
        "command": "node scripts/serve-docs.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
