{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudAccessToken": "",
  "namedInputs": {
    "compileConfig": [
      "{projectRoot}/build-configs/configurations.json",
      { "env": "OCJS_CONFIG" },
      { "env": "OCJS_OPT" },
      { "env": "OCJS_EXTRA_CFLAGS" },
      { "env": "OCJS_LTO" },
      { "env": "OCJS_EXCEPTIONS" },
      { "env": "OCJS_EH_MODE" },
      { "env": "OCJS_SIMD" },
      { "env": "THREADING" },
      { "env": "OCJS_DEFINES" },
      { "env": "OCJS_UNDEFINES" }
    ],
    "linkConfig": [
      { "env": "OCJS_WASM_OPT_LEVEL" },
      { "env": "OCJS_CLOSURE" },
      { "env": "OCJS_CONVERGE" },
      { "env": "OCJS_EVAL_CTORS" },
      { "env": "OCJS_EVAL_CTORS_LEVEL" },
      { "env": "OCJS_BIGINT" },
      { "env": "OCJS_SKIP_WASM_OPT" },
      { "env": "BINARYEN_EXTRA_PASSES" },
      { "env": "OCJS_MALLOC" }
    ],
    "toolchain": [{ "runtime": "emcc --version 2>/dev/null || echo not-installed" }],
    "depsVersion": ["{projectRoot}/DEPS.json"],
    "generatorCode": ["{projectRoot}/src/**/*.py", "{projectRoot}/bindgen-filters.yaml"],
    "buildScript": ["{projectRoot}/build-wasm.sh"],
    "patchScripts": ["{projectRoot}/src/patches/*.py", "{projectRoot}/src/patches/*.patch"],
    "compileBindingsScript": [
      "{projectRoot}/src/compileBindings.py",
      "{projectRoot}/src/ocjs_bindgen/config/**/*.py"
    ],
    "linkScript": [
      "{projectRoot}/src/ocjs_bindgen/link/**/*.py",
      "{projectRoot}/src/ocjs_bindgen/config/**/*.py"
    ]
  }
}
